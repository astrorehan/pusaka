# Jaringan: "anvil" (blockchain lokal) atau "monad" (Monad testnet)
VITE_CHAIN=anvil
# RPC untuk browser. Kosongkan untuk anvil: web memakai /rpc yang diteruskan server Vite ke anvil.
# Untuk acara di Monad testnet disarankan RPC berkunci (RPC publik dibatasi per IP).
VITE_RPC=
# Alamat kontrak. Anvil: node scripts/deploy-lokal.mjs mengisinya otomatis.
# Monad testnet: dari `forge script script/Deploy.s.sol` (lihat contracts/README.md).
VITE_TOKEN=
VITE_FACTORY=
VITE_WALLET=
VITE_MITRA=
# Ambang isi gas di browser (jumlah sebenarnya diatur server: GAS_MON dan GAS_AMPLOP)
VITE_GAS_MON=0.2
VITE_GAS_AMPLOP=0.08
# Alamat publik untuk QR di Panggung (mis. https://pusaka.vercel.app atau http://192.168.1.5:5180)
VITE_PUBLIC_URL=
# Alamat relayer bila situs statis ini (GitHub Pages) memakai relayer di Vercel, mis. https://pusaka.vercel.app/api/induk.
# Kosong = /api/induk di situs yang sama (dev server Vite atau Vercel).
VITE_RELAYER_URL=

# ---- Hanya untuk server (TIDAK pernah masuk ke browser; jangan diberi awalan VITE_) ----
# Dompet induk: membagikan gas dan tIDR, menjadi relayer (kabar hidup, saksi), operator mitra, dan pemilik MitraCair.
# KHUSUS TESTNET. Di anvil boleh kosong (memakai akun anvil nomor 0).
# Dev server Vite membacanya dari sini; nama lama VITE_INDUK_KEY masih dikenali, tetapi tidak dikirim ke browser.
INDUK_KEY=
# Opsional di dev server (bawaan: diambil dari VITE_* di atas; RPC_URL bawaan = ANVIL_URL atau VITE_RPC)
# RPC_URL=  TOKEN=  WALLET=  MITRA=  CHAIN_ID=  GAS_MON=  GAS_AMPLOP=
# Hanya untuk server Vite: anvil yang diteruskan lewat /rpc (dan dipakai relayer)
ANVIL_URL=http://127.0.0.1:8545
