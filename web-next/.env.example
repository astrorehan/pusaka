# Variabel untuk web-next (Next.js). Di Vercel isi di Project Settings > Environment Variables.
# Lokal (anvil): tidak perlu mengisi apa pun. next.config.mjs membaca alamat kontrak dari ../web/.env.local
# (hasil `node scripts/deploy-lokal.mjs`) dan memakai akun anvil nomor 0 sebagai dompet induk.

# ---- Server saja (rahasia, TANPA awalan NEXT_PUBLIC_) ----
INDUK_KEY=            # kunci dompet induk (berisi MON). Hanya dibaca /api/induk
RPC_URL=              # RPC server (disarankan RPC berkunci)
CHAIN_ID=10143        # 10143 = Monad testnet, 31337 = anvil
TOKEN=                # alamat MockIDR
WALLET=               # alamat PusakaWallet
MITRA=                # alamat MitraCair
FACTORY=              # opsional
GAS_MON=0.2
GAS_AMPLOP=0.08

# ---- Publik (ikut ke browser, jangan isi rahasia) ----
# Alamat kontrak, jaringan, GAS_* otomatis diturunkan dari variabel server di atas saat build.
NEXT_PUBLIC_PUBLIC_URL=   # https://<domain>, untuk QR di Panggung
NEXT_PUBLIC_RPC=          # RPC untuk browser (opsional; kosong = RPC publik Monad testnet)
NEXT_PUBLIC_RELAYER_URL=  # opsional: relayer di domain lain (kosong = /api/induk di situs yang sama)
