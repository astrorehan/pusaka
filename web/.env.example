# Jaringan: "anvil" (blockchain lokal) atau "monad" (Monad testnet)
VITE_CHAIN=anvil
# RPC. Kosongkan untuk anvil: web memakai /rpc yang diteruskan server Vite ke anvil.
# Untuk acara di Monad testnet disarankan RPC berkunci (RPC publik dibatasi per IP).
VITE_RPC=
# Alamat kontrak. Anvil: node scripts/deploy-lokal.mjs mengisinya otomatis.
# Monad testnet: dari `forge script script/Deploy.s.sol` (lihat contracts/README.md).
VITE_TOKEN=
VITE_FACTORY=
VITE_WALLET=
VITE_MITRA=
# Dompet induk: membagikan gas dan tIDR, menjadi relayer (kabar hidup, saksi), dan pemilik MitraCair.
# KHUSUS TESTNET, ikut terbawa ke browser. Di anvil boleh kosong (memakai akun anvil nomor 0).
VITE_INDUK_KEY=
# MON yang dikirim ke kunci pewaris dan operator mitra saat "Bagikan gas"
VITE_GAS_MON=0.2
# MON yang disponsori untuk tiap amplop digital
VITE_GAS_AMPLOP=0.08
# Alamat publik untuk QR di Panggung (mis. https://pusaka.vercel.app atau http://192.168.1.5:5180)
VITE_PUBLIC_URL=
# Hanya untuk server Vite: anvil yang diteruskan lewat /rpc
ANVIL_URL=http://127.0.0.1:8545
